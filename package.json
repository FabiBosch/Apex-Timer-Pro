{
  "name": "apextimerpro",
  "version": "1.0.14",
  "description": "Apex Timer Pro - Carrera-Bahn Zeitmessung",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "selfsigned": "^5.5.0"
  },
  "build": {
    "appId": "com.fabi.apextimerpro",
    "productName": "Apex Timer Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "local-server.js",
      "cert-manager.js",
      "docs/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "docs/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "publish": {
      "provider": "github",
      "owner": "FabiBosch",
      "repo": "Apex-Timer-Pro"
    }
  }
}