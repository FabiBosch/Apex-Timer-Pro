{
  "name": "apextimerpro",
  "version": "1.0.1",
  "description": "Apex Timer Pro - Carrera-Bahn Zeitmessung",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.fabi.apextimerpro",
    "productName": "Apex Timer Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "docs/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "FabiBosch",
      "repo": "Apex-Timer-Pro",
      "private": true
    }
  }
}